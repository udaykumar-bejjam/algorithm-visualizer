{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "components": ["components"],
      "components/*": ["components/*"],
      "apis": ["apis"],
      "apis/*": ["apis/*"],
      "common/*": ["common/*"],
      "core/*": ["core/*"],
      "files": ["files"],
      "files/*": ["files/*"],
      "reducers": ["reducers"],
      "reducers/*": ["reducers/*"]
    }
  },
  "exclude": ["node_modules", "build"]
}
